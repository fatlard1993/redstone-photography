{
	"schemaVersion": 1,
	"id": "redstone-photography",
	"version": "${version}",
	"name": "Redstone Photography",
	"description": "A camera and film: take a picture of what you see, develop it in a cauldron in a darkroom lit only by redstone, and hang the print on a wall (server-side with Pandorical)",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/redstone-photography"
	},
	"license": "MIT",
	"icon": "assets/redstone-photography/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.redstone_photography.Main"
		]
	},
	"mixins": [
		"redstone-photography.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=15.15.0"
	}
}
